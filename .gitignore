# Secrets — НИКОГДА не коммитить
.env
.env.*
!.env.example
*.save
yml.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / frontend
node_modules/
cabinet/dist/
*.local
*.tsbuildinfo

# Build artifacts / archives
*.tar.gz
backups/
logs/
*.log

# Дампы БД (update.sh кладёт их в корень) — НИКОГДА не коммитить: данные юзеров
backup-*.sql.gz
*.sql.gz
*.sql

# Оформление/состояние конкретной установки — не часть кода
assets/branding.json
assets/logo.*
assets/menu.json
assets/reminders.json
assets/update_state.json
# Секреты и рантайм-конфиги/стейт конкретной установки — НИКОГДА не коммитим
# (push_vapid.json — приватный VAPID-ключ; email.json/auth.json — креды).
assets/push_vapid.json
assets/node_health.json
assets/push_notify_state.json
assets/cashback.json
assets/topup.json
assets/morning_summary.json
assets/auth.json
assets/email.json
assets/info_content.json
assets/server_status.json
assets/morning_summary_state.json
assets/app_links.json
# Все рантайм-стейт файлы кронов (дедуп/бейзлайны) — не часть кода, не публикуем.
assets/*_state.json
assets/app_links_alert_state.json

# НАДЁЖНО: любой assets/*.json — это per-install конфиг/стейт/секрет (branding,
# push_vapid=приватный ключ, admin_ip=IP владельца, тумблеры фич и т.п.), КРОМЕ
# единственного сид-файла apps.json. Так новые конфиги фич не «протекут» в git.
assets/*.json
!assets/apps.json
# Бэкапы конфигов/секретов (напр. email.json.bak.<ts> — содержит SMTP-креды) и *.orig
# от мержей — НИКОГДА в git (см. incident-db-dumps-leaked).
*.bak
*.bak.*
*.orig

# Пользовательские ассеты оператора — держим ТОЛЬКО в volume, НЕ в репо: иначе
# апдейт (git reset --hard / архив) затирает правки, а фирменный баннер владельца
# утекает в публичный репозиторий. Трекнутыми остаются шаблон custom.ftl.example и
# .gitkeep (чтобы каталоги существовали); базовый образ досевает дефолты при отсутствии.
assets/translations/*/custom.ftl
# Баннеры оператора — все форматы, что отдаёт бот (BannerFormat: jpg/jpeg/png/gif/webp).
# `**/*.ext` покрывает и корень assets/banners/, и подпапки локалей.
assets/banners/**/*.jpg
assets/banners/**/*.jpeg
assets/banners/**/*.png
assets/banners/**/*.gif
assets/banners/**/*.webp

# Editor / OS
.DS_Store
.idea/
.vscode/

# Claude
.claude/

# Локальный HA-оверлей (инфра-кастом, не публиковать)
docker-compose.local-ha.yml
cabinet/nginx.failover.conf

# Внутренние security-аудиты — описывают конкретную установку (домены, недавно
# закрытые дыры, внутреннюю архитектуру); в public git это карта для атакующего.
docs/SECURITY-AUDIT-*.md

# Owner-локальные компоненты кабинета (файлы с суффиксом .local) — держим только
# в рабочем дереве конкретной установки, в публичный репозиторий не публикуем.
cabinet/src/**/*.local.tsx
cabinet/src/**/*.local.ts

# Кастом страницы подписки Remnawave (sub.<домен>) — инфра конкретной установки,
# НЕ в git (Фаза 14 роадмапа): бренд/цвета/патч index.html + re-patch скрипт.
assets/sub_app_config.json
assets/sub_app_config.base.json
assets/sub_index.html
scripts/patch-sub-index.sh

# Приватный раздел абьюза в боте (Фаза 3, только владельцу) — в образ через COPY,
# в публичный GitHub НЕ выкладываем (кабинетный детект открыт, ботовый — приватный).
admin_src/src/telegram/routers/overlay_abuse.py
assets/sub_index.html.bak

# Состояние адаптера (паузы подписок) — рантайм конкретной установки.
adapter-state/
*.db
