{
  "backend": "bedolaga",
  "prefix": "/cabinet",
  "routes": {
    "/api/auth/refresh": {
      "target": "/cabinet/auth/refresh",
      "kind": "direct",
      "methods": [
        "POST"
      ]
    },
    "/api/auth/login": {
      "target": "/cabinet/auth/email/login",
      "kind": "renamed",
      "methods": [
        "POST"
      ]
    },
    "/api/auth/register": {
      "target": "/cabinet/auth/email/register/standalone",
      "kind": "renamed",
      "methods": [
        "POST"
      ]
    },
    "/api/auth/logout": {
      "target": "/cabinet/auth/logout",
      "kind": "direct",
      "methods": [
        "POST"
      ]
    },
    "/api/auth/telegram": {
      "target": "/cabinet/auth/telegram",
      "kind": "direct",
      "methods": [
        "POST"
      ]
    },
    "/api/auth/password/reset/request": {
      "target": "/cabinet/auth/deeplink/request",
      "kind": "renamed",
      "methods": [
        "POST"
      ]
    },
    "/api/auth/email/change": {
      "target": "/cabinet/auth/email/change",
      "kind": "direct",
      "methods": [
        "POST"
      ]
    },
    "/api/subscription/trial": {
      "target": "/cabinet/subscription/trial",
      "kind": "direct",
      "methods": [
        "GET",
        "POST"
      ]
    },
    "/api/subscription/devices": {
      "target": "/cabinet/subscription/devices",
      "kind": "direct",
      "methods": [
        "DELETE",
        "GET",
        "POST"
      ]
    },
    "/api/subscription/devices/{hwid}": {
      "target": "/cabinet/subscription/devices/{hwid}",
      "kind": "direct",
      "methods": [
        "DELETE"
      ]
    },
    "/api/notifications": {
      "target": "/cabinet/notifications",
      "kind": "direct",
      "methods": [
        "GET",
        "PATCH"
      ]
    },
    "/api/support/tickets/{id}/messages": {
      "target": "/cabinet/tickets/{ticket_id}/messages",
      "kind": "renamed",
      "methods": [
        "POST"
      ]
    }
  },
  "todo": [
    "/api/auth/telegram/webapp",
    "/api/auth/telegram/link",
    "/api/auth/change-password",
    "/api/auth/password/set",
    "/api/auth/password/reset/confirm",
    "/api/auth/email/request-verification",
    "/api/auth/email/confirm",
    "/api/auth/email",
    "/api/subscription/extend",
    "/api/subscription/pay-with-balance",
    "/api/subscription/reissue",
    "/api/subscription/server-stats",
    "/api/subscription/traffic-history",
    "/api/subscription/service-status",
    "/api/subscription/freeze-status",
    "/api/subscription/freeze",
    "/api/subscription/unfreeze",
    "/api/plans/public",
    "/api/apps",
    "/api/balance/topup/config",
    "/api/balance/spend-on-renewal",
    "/api/balance/convert-points",
    "/api/referral/program",
    "/api/gift/my",
    "/api/promo-banner",
    "/api/trial-discount",
    "/api/notifications?limit=",
    "/api/notifications/unread-count",
    "/api/notifications/read",
    "/api/push/vapid-key",
    "/api/push/status",
    "/api/push/subscribe",
    "/api/push/unsubscribe",
