    "/api/sessions/logout-all",
    "/api/support/tickets",
    "/api/support/tickets",
    "/api/support/tickets/{id}",
    "/api/support/tickets/{id}/close",
    "/api/account/delete",
    "/api/gift/create",
    "/api/account/export",
    "/api/info",
